diff --git a/client/easyconnect/l3conn_terminal_test.go b/client/easyconnect/l3conn_terminal_test.go
new file mode 100644
index 0000000..37336e2
--- /dev/null
+++ b/client/easyconnect/l3conn_terminal_test.go
@@ -0,0 +1,31 @@
+package easyconnect
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+type brokenL3Transport struct{}
+
+func (brokenL3Transport) Write([]byte) (int, error) { return 0, io.ErrClosedPipe }
+func (brokenL3Transport) Read([]byte) (int, error)  { return 0, io.EOF }
+func (brokenL3Transport) Close() error              { return nil }
+
+// SendConn and RecvConn return a typed nil pointer and an error when no token is
+// available, just as they do when the server shuts down a session. A second
+// concurrent packet must report the error instead of calling a nil UConn.
+func TestL3ConnReturnsTerminalReconnectErrors(t *testing.T) {
+	conn := &L3Conn{easyConnectClient: &Client{}, sendConn: brokenL3Transport{}, recvConn: brokenL3Transport{}}
+	for i := 0; i < 3; i++ {
+		if _, err := conn.Write([]byte("packet")); err == nil || !strings.Contains(err.Error(), "token is nil") {
+			t.Fatalf("Write #%d returned %v", i, err)
+		}
+		if _, err := conn.Read(make([]byte, 1)); err == nil || !strings.Contains(err.Error(), "token is nil") {
+			t.Fatalf("Read #%d returned %v", i, err)
+		}
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/client/traffic.go b/client/traffic.go
new file mode 100644
index 0000000..1eb1f32
--- /dev/null
+++ b/client/traffic.go
@@ -0,0 +1,67 @@
+package client
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync/atomic"
+)
+
+// TrafficClient counts VPN payload transferred through the stack, not host-wide traffic.
+type TrafficClient struct {
+	Client
+	received atomic.Uint64
+	sent     atomic.Uint64
+}
+
+func NewTrafficClient(c Client) *TrafficClient    { return &TrafficClient{Client: c} }
+func (c *TrafficClient) Totals() (uint64, uint64) { return c.received.Load(), c.sent.Load() }
+func (c *TrafficClient) SetIPUpdateHandler(handler func(net.IP) error) {
+	RegisterIPUpdateHandler(c.Client, handler)
+}
+func (c *TrafficClient) NewL3Conn() (io.ReadWriteCloser, error) {
+	conn, err := c.Client.NewL3Conn()
+	if err != nil {
+		return nil, err
+	}
+	return &trafficReadWriteCloser{ReadWriteCloser: conn, client: c}, nil
+}
+func (c *TrafficClient) DialTCP(ctx context.Context, addr *net.TCPAddr) (net.Conn, error) {
+	conn, err := c.Client.DialTCP(ctx, addr)
+	if err != nil {
+		return nil, err
+	}
+	return &trafficNetConn{Conn: conn, client: c}, nil
+}
+
+type trafficReadWriteCloser struct {
+	io.ReadWriteCloser
+	client *TrafficClient
+}
+
+func (c *trafficReadWriteCloser) Read(p []byte) (int, error) {
+	n, err := c.ReadWriteCloser.Read(p)
+	c.client.received.Add(uint64(n))
+	return n, err
+}
+func (c *trafficReadWriteCloser) Write(p []byte) (int, error) {
+	n, err := c.ReadWriteCloser.Write(p)
+	c.client.sent.Add(uint64(n))
+	return n, err
+}
+
+type trafficNetConn struct {
+	net.Conn
+	client *TrafficClient
+}
+
+func (c *trafficNetConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	c.client.received.Add(uint64(n))
+	return n, err
+}
+func (c *trafficNetConn) Write(p []byte) (int, error) {
+	n, err := c.Conn.Write(p)
+	c.client.sent.Add(uint64(n))
+	return n, err
+}
diff --git a/client/traffic_test.go b/client/traffic_test.go
new file mode 100644
index 0000000..a1eaf79
--- /dev/null
+++ b/client/traffic_test.go
@@ -0,0 +1,84 @@
+package client
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+)
+
+type testTrafficClient struct {
+	Client
+	l3   io.ReadWriteCloser
+	conn net.Conn
+	err  error
+}
+
+func (c *testTrafficClient) NewL3Conn() (io.ReadWriteCloser, error) { return c.l3, c.err }
+func (c *testTrafficClient) DialTCP(context.Context, *net.TCPAddr) (net.Conn, error) {
+	return c.conn, c.err
+}
+
+type testTrafficStream struct{ bytes.Buffer }
+
+func (*testTrafficStream) Close() error { return nil }
+
+func TestTrafficCountsL3Payload(t *testing.T) {
+	stream := &testTrafficStream{}
+	stream.WriteString("hello")
+	c := NewTrafficClient(&testTrafficClient{l3: stream})
+	conn, err := c.NewL3Conn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 3)
+	if _, err := io.ReadFull(conn, buffer); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.Write([]byte("four")); err != nil {
+		t.Fatal(err)
+	}
+	received, sent := c.Totals()
+	if received != 3 || sent != 4 {
+		t.Fatalf("got received=%d sent=%d", received, sent)
+	}
+}
+func TestTrafficCountsTCPAndPreservesErrors(t *testing.T) {
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	c := NewTrafficClient(&testTrafficClient{conn: left})
+	conn, err := c.DialTCP(context.Background(), &net.TCPAddr{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { _, err := right.Write([]byte("abc")); done <- err }()
+	if _, err := io.ReadFull(conn, make([]byte, 3)); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	go func() { _, err := io.ReadFull(right, make([]byte, 4)); done <- err }()
+	if _, err := conn.Write([]byte("four")); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	received, sent := c.Totals()
+	if received != 3 || sent != 4 {
+		t.Fatalf("got received=%d sent=%d", received, sent)
+	}
+	want := errors.New("connect failed")
+	broken := NewTrafficClient(&testTrafficClient{err: want})
+	if _, err := broken.NewL3Conn(); !errors.Is(err, want) {
+		t.Fatalf("NewL3Conn error = %v", err)
+	}
+	if _, err := broken.DialTCP(context.Background(), &net.TCPAddr{}); !errors.Is(err, want) {
+		t.Fatalf("DialTCP error = %v", err)
+	}
+}
